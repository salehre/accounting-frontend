# Where the Laravel backend runs (used only by the dev server proxy)
BACKEND_URL=http://localhost:8000

# multi = one database per company (the company code is asked at login)
# single = one company (the company field is hidden)
NUXT_PUBLIC_TENANCY=multi

# Where the browser sends API calls. Keep /api: in development Nuxt proxies it to the backend,
# in production the web server (nginx...) does.
NUXT_PUBLIC_API_BASE=/api
